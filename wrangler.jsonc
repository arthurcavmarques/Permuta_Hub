// Cloudflare Workers (assets estáticos) servindo o build do Vite como SPA. Ver D012 e docs/runbook.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "permutahub",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
