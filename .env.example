# Copie para .env.local (frontend) e .env (scripts). NUNCA commite os arquivos reais.
# Valores locais aparecem em `npx supabase status`.

# --- Frontend (público: vai para o navegador) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Scripts de importação/admin (SECRETO: nunca no frontend) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
